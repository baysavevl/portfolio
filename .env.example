# Copy this file to .env.local and replace every Sanity placeholder locally.
# Never commit .env.local or real credentials.
CONTENT_SOURCE=demo
NEXT_PUBLIC_SANITY_PROJECT_ID=project-id-from-sanity-manage
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-10
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep every server-held value blank until you create it for this project.
# Follow docs/runbooks/sanity-setup.md; never reuse a committed placeholder.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
ALLOW_DEMO_SEED=false
